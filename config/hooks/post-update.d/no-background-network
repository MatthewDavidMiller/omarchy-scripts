#!/usr/bin/env bash
# Re-disable weather/agents polling and telemetry after shell.json migrations.
set -euo pipefail
pointer="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-scripts/repo"
[[ -f "$pointer" ]] || { printf 'omarchy-scripts: repo pointer missing (%s)\n' "$pointer" >&2; exit 1; }
root="$(cat -- "$pointer")"
[[ -x "$root/bin/setup-no-background-network" ]] \
  || { printf 'omarchy-scripts: setup-no-background-network missing in %s\n' "$root" >&2; exit 1; }
exec "$root/bin/setup-no-background-network" --yes
