#!/usr/bin/env bash
# Re-apply the [omarchy] SigLevel after `omarchy refresh pacman` copies its template.
set -euo pipefail
pointer="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-scripts/repo"
[[ -f "$pointer" ]] || { printf 'omarchy-scripts: repo pointer missing (%s)\n' "$pointer" >&2; exit 1; }
root="$(cat -- "$pointer")"
[[ -x "$root/bin/setup-security-hardening" ]] \
  || { printf 'omarchy-scripts: setup-security-hardening missing in %s\n' "$root" >&2; exit 1; }
exec "$root/bin/setup-security-hardening" --siglevel-only --yes
