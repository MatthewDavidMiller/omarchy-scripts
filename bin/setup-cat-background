#!/usr/bin/env bash
#
# setup-cat-background — install the pixel-art cat on the desktop and unlock screen.
#
# order: 65
# description: Set the pixel-art cat as the wallpaper and disk unlock image
#
# Scales the approved generated pixel-art asset into desktop and Plymouth
# images. They live in user-owned Omarchy directories so stock files remain
# untouched.
#
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

SOURCE_IMAGE="$SCRIPT_DIR/../assets/cat-wallpaper.png"
STATE="$HOME/.local/state/omarchy/current"
BACKGROUND_NAME="pixel-cat.png"
UNLOCK_NAME="pixel-cat-unlock.png"
SIZE="3840x2160"
UNLOCK_SIZE="800x450"
BACKGROUND="#77797c"
PLYMOUTH_TEXT="#ffffff"
PLYMOUTH_INSTALLED_LOGO="${PLYMOUTH_INSTALLED_LOGO:-/usr/share/plymouth/themes/omarchy/logo.png}"
ACTIVATE=1
FORCE=0

usage() {
  cat <<'USAGE'
Usage: setup-cat-background [options]

Scales assets/cat-wallpaper.png into desktop and Plymouth images, writes them
to user-owned Omarchy directories, and applies both.

Options:
  --size WxH      Canvas size (default 3840x2160).
  --no-activate   Generate both images without applying either one.
  --force         Re-render even if the existing wallpaper already matches.
  -n, --dry-run   Show what would change without changing anything.
  -y, --yes       Accepted for setup-all compatibility.
  -h, --help      Show this help.

Environment:
  DRY_RUN=1       Same as --dry-run.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --size)        SIZE="${2:-}"; shift ;;
    --no-activate) ACTIVATE=0 ;;
    --force)       FORCE=1 ;;
    -n|--dry-run)  DRY_RUN=1 ;;
    -y|--yes)      ASSUME_YES=1 ;;
    -h|--help)     usage; exit 0 ;;
    *)             usage >&2; die "Unknown argument: $1" ;;
  esac
  shift
done

[[ "$SIZE" =~ ^[0-9]+x[0-9]+$ ]] || die "Invalid --size: $SIZE (expected WxH)"

require_not_root
require_cmd omarchy

[[ -f "$SOURCE_IMAGE" ]] || die "Missing pixel art: $SOURCE_IMAGE"

# ImageMagick comes from Arch's official repositories, never AUR.
if ! omarchy pkg present imagemagick; then
  log "Installing ImageMagick to render the wallpaper"
  run omarchy pkg add imagemagick
fi
[[ "$DRY_RUN" == "1" ]] || require_cmd magick

theme_name="$(cat "$STATE/theme.name" 2>/dev/null || true)"
[[ -n "$theme_name" ]] || die "No active Omarchy theme found at $STATE/theme.name"

target_dir="$HOME/.config/omarchy/backgrounds/$theme_name"
target="$target_dir/$BACKGROUND_NAME"
unlock_dir="$HOME/.config/omarchy/plymouth/$theme_name"
unlock_target="$unlock_dir/$UNLOCK_NAME"

render_wallpaper() {
  local output="$1"
  # Preserve the generated pixel edges and full RGB palette. The source is
  # already 16:9; extent only supplies a neutral edge for other requested sizes.
  # Excluding metadata timestamps keeps byte comparisons deterministic.
  magick "$SOURCE_IMAGE" \
    -filter point -resize "$SIZE" \
    -background "$BACKGROUND" -gravity center -extent "$SIZE" \
    -strip -define png:exclude-chunk=date,time \
    "PNG24:$output"
}

render_unlock() {
  local output="$1"
  # Flood-fill the connected neutral backdrop, then fit the untouched cat into
  # a transparent Plymouth logo canvas. Transparency avoids a visible rectangle
  # against Plymouth's flat neutral-gray background.
  magick "$SOURCE_IMAGE" \
    -alpha on -bordercolor "$BACKGROUND" -border 1 -fuzz 10% \
    -fill none -draw 'alpha 0,0 floodfill' -shave 1x1 -trim +repage \
    -filter point -resize "$UNLOCK_SIZE" \
    -background none -gravity center -extent "$UNLOCK_SIZE" \
    -strip -define png:exclude-chunk=date,time \
    "PNG32:$output"
}

if [[ "$DRY_RUN" == "1" ]]; then
  printf '%s  dry%s would render %s at %s from %s\n' \
    "$C_DIM" "$C_RESET" "$target" "$SIZE" "$(basename "$SOURCE_IMAGE")"
  printf '%s  dry%s would render %s at %s from %s\n' \
    "$C_DIM" "$C_RESET" "$unlock_target" "$UNLOCK_SIZE" "$(basename "$SOURCE_IMAGE")"
  [[ "$ACTIVATE" == "1" ]] && printf '%s  dry%s omarchy theme bg set %s\n' "$C_DIM" "$C_RESET" "$target"
  [[ "$ACTIVATE" == "1" ]] && printf '%s  dry%s omarchy plymouth set %s %s %s\n' \
    "$C_DIM" "$C_RESET" "$BACKGROUND" "$PLYMOUTH_TEXT" "$unlock_target"
  exit 0
fi

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

log "Rendering $theme_name cat wallpaper at $SIZE"
render_wallpaper "$tmp/$BACKGROUND_NAME"
render_unlock "$tmp/$UNLOCK_NAME"

install_render() {
  local rendered="$1" destination="$2"
  if [[ "$FORCE" != "1" ]] && [[ -f "$destination" ]] && cmp -s "$rendered" "$destination"; then
    skip "$destination already up to date"
    return
  fi

  mkdir -p "$(dirname "$destination")"
  [[ -f "$destination" ]] && cp -a "$destination" "$destination.bak.$(date +%Y%m%d%H%M%S)"
  mv "$rendered" "$destination"
  ok "wrote $destination"
}

install_render "$tmp/$BACKGROUND_NAME" "$target"
install_render "$tmp/$UNLOCK_NAME" "$unlock_target"

if [[ "$ACTIVATE" == "1" ]]; then
  # Omarchy Shell deliberately ignores a background-set IPC call when the path
  # string has not changed, and its base Image caches that path. Bounce through
  # a private cache alias before returning to the stable target so the final
  # cache-disabled transition decodes the current bytes. Keep the persisted
  # current-background symlink pointed at the stable user-background path.
  reload_dir="${XDG_CACHE_HOME:-$HOME/.cache}/omarchy"
  reload_target="$reload_dir/pixel-cat-reload.png"
  mkdir -p "$reload_dir"
  cp -f "$target" "$reload_target"
  run omarchy theme bg set "$target"
  run omarchy shell background setInstant "$reload_target"
  run omarchy shell background set "$target"
  ok "refreshed live background"

  if [[ "$FORCE" != "1" ]] && [[ -f "$PLYMOUTH_INSTALLED_LOGO" ]] && cmp -s "$unlock_target" "$PLYMOUTH_INSTALLED_LOGO"; then
    skip "Plymouth unlock image already up to date"
  else
    log "Setting the Plymouth disk-encryption unlock image"
    run omarchy plymouth set "$BACKGROUND" "$PLYMOUTH_TEXT" "$unlock_target"
    ok "updated Plymouth unlock image"
  fi
fi

run omarchy theme bg cache || true
