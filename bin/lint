#!/usr/bin/env bash
#
# lint — shellcheck (and optionally shfmt) for every script in this repo.
#
# Runs the linters inside a throwaway container, so the only dependency is a
# container engine. Nothing is installed on the host.
#
# Rootless podman is preferred over docker, and is what bin/setup-rootless-podman
# leaves on the machine. Either engine works; see run_args() for the one place
# they genuinely differ.
#
# The image is built here from docker/lint.Dockerfile, on top of alpine — a
# Docker Official Image pinned by digest — rather than pulled from a third
# party. Built once, then cached; the tag tracks the Dockerfile's hash, so
# editing it rebuilds automatically.
#
# Not a setup script: deliberately named `lint`, not `setup-lint`, so setup-all
# does not pick it up as system configuration.
#
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

DOCKERFILE="$REPO_ROOT/docker/lint.Dockerfile"

USE_CONTAINER=auto
RUN_FMT=0
FIX=0
REBUILD=0
LINT_IMAGE=""

usage() {
  cat <<'USAGE'
Usage: lint [options] [file...]

Runs shellcheck over the repo's shell scripts. With no files given, lints
everything tracked in bin/, lib/, and githooks/.

Options:
      --fmt           Also check formatting with shfmt.
      --fix           Reformat in place with shfmt (implies --fmt).
      --rebuild       Rebuild the lint image even if it is already cached.
      --no-container  Use host-installed shellcheck/shfmt instead of a container.
      --container     Require a container; fail rather than fall back.
  -h, --help          Show this help.

Exit codes:
  0  clean   1  problems found   3  no linter available

The image is built from docker/lint.Dockerfile (alpine + shellcheck + shfmt)
and cached. Podman is preferred over docker; set OMARCHY_CONTAINER_ENGINE to
pick one explicitly, or OMARCHY_LINT_IMAGE to use a prebuilt image.
USAGE
}

FILES=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --fmt)          RUN_FMT=1 ;;
    --rebuild)      REBUILD=1 ;;
    --fix)          RUN_FMT=1; FIX=1 ;;
    --no-container) USE_CONTAINER=no ;;
    --container)    USE_CONTAINER=yes ;;
    -h|--help)      usage; exit 0 ;;
    -*)             usage >&2; die "Unknown argument: $1" ;;
    *)              FILES+=("$1") ;;
  esac
  shift
done

# --- engine ----------------------------------------------------------------

CONTAINER_ENGINE=""
ENGINE_ROOTLESS=0

detect_engine() {
  # Podman first: it needs no daemon and no root, so on a machine that has both
  # it is the one that will actually answer. OMARCHY_CONTAINER_ENGINE pins a
  # single engine instead — naming one means that one, not "prefer" it.
  local engine
  local -a candidates=(podman docker)
  [[ -n "${OMARCHY_CONTAINER_ENGINE:-}" ]] && candidates=("$OMARCHY_CONTAINER_ENGINE")

  for engine in "${candidates[@]}"; do
    have "$engine" || continue
    # An installed client with no reachable daemon is worse than no client at
    # all: it fails slowly and confusingly. Check before committing to it.
    if timeout 20 "$engine" info >/dev/null 2>&1; then
      CONTAINER_ENGINE="$engine"
      # Rootless podman maps the caller's uid to root inside the container, and
      # every other uid into the subuid range. That changes how --user has to
      # be spelled; ask the engine rather than guessing from its name, since
      # podman can also be run rootful.
      if [[ "$engine" == "podman" ]] \
        && [[ "$(podman info --format '{{.Host.Security.Rootless}}' 2>/dev/null)" == "true" ]]; then
        ENGINE_ROOTLESS=1
      fi
      return 0
    fi
  done
  return 1
}

# --- image -----------------------------------------------------------------

# Tag by the Dockerfile's own hash: change the file and the next run rebuilds,
# with no version constant to remember to bump.
image_name() {
  if [[ -n "${OMARCHY_LINT_IMAGE:-}" ]]; then
    printf '%s' "$OMARCHY_LINT_IMAGE"
    return 0
  fi
  local hash
  hash="$(sha256sum "$DOCKERFILE" | cut -c1-12)"
  printf 'omarchy-scripts/lint:%s' "$hash"
}

ensure_image() {
  local image="$1"

  # A caller-supplied image is theirs to manage; never build over it.
  [[ -n "${OMARCHY_LINT_IMAGE:-}" ]] && return 0

  if [[ "$REBUILD" == "0" ]] && "$CONTAINER_ENGINE" image inspect "$image" >/dev/null 2>&1; then
    return 0
  fi

  [[ -f "$DOCKERFILE" ]] || die "Missing $DOCKERFILE"
  log "Building $image (once; ~5s)"
  # Build context is docker/ alone — the repo itself is never sent to the daemon.
  run "$CONTAINER_ENGINE" build --quiet \
    --tag "$image" \
    --file "$DOCKERFILE" \
    "$(dirname "$DOCKERFILE")" >/dev/null \
    || die "Failed to build $image"
  ok "built $image"

  # Hash tags accumulate one per Dockerfile edit. Drop the superseded ones now
  # that the new image is known good.
  #
  # By tag, not by id: an edit that touches only comments rebuilds to layers
  # that are byte-identical, so the old and new tags name the same image and an
  # id-based prune can never tell them apart. Removing the tag untags a shared
  # image and deletes one nothing else names any more, which is right either
  # way. The refs come from the engine's own output, so podman's localhost/
  # prefix is carried back to podman verbatim.
  local stale
  stale="$("$CONTAINER_ENGINE" images --format '{{.Repository}}:{{.Tag}}' \
    --filter "reference=omarchy-scripts/lint" | grep -v ":${image##*:}$" || true)"
  if [[ -n "$stale" ]]; then
    # shellcheck disable=SC2086  # deliberate word splitting: one ref per line
    "$CONTAINER_ENGINE" rmi $stale >/dev/null 2>&1 || true
  fi
}

# --- file discovery --------------------------------------------------------

discover_files() {
  local file line
  shopt -s nullglob
  for file in "$REPO_ROOT"/bin/* "$REPO_ROOT"/lib/*.sh "$REPO_ROOT"/githooks/* \
              "$REPO_ROOT"/tests/run "$REPO_ROOT"/tests/*.sh; do
    [[ -f "$file" ]] || continue
    [[ "$file" == *.bak.* ]] && continue
    # bin/ holds commands, not only shell ones. shellcheck errors out on a
    # script it cannot parse (SC1071), so decide by shebang rather than by
    # location — otherwise adding one Python tool fails the whole lint.
    read -r line < "$file" || true
    [[ "$line" =~ ^#!.*(bash|dash|ksh|sh)([[:space:]]|$) ]] || continue
    printf '%s\n' "${file#"$REPO_ROOT"/}"
  done
  shopt -u nullglob
}

if [[ ${#FILES[@]} -eq 0 ]]; then
  mapfile -t FILES < <(discover_files)
else
  # Normalise caller-supplied paths to repo-relative, so they resolve the same
  # on the host and inside the container.
  normalised=()
  for f in "${FILES[@]}"; do
    abs="$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
    case "$abs" in
      "$REPO_ROOT"/*) normalised+=("${abs#"$REPO_ROOT"/}") ;;
      *) die "Not inside the repo: $f" ;;
    esac
  done
  FILES=("${normalised[@]}")
fi

[[ ${#FILES[@]} -eq 0 ]] && { skip "No shell scripts to lint."; exit 0; }

# --- runners ---------------------------------------------------------------

# user_args — how to spell "run as me" for the engine we found.
#
# Under docker the daemon is root, so --user is simply the uid to drop to and
# the bind mount is seen with the host's own uids.
#
# Under rootless podman the whole container already runs as the caller, inside
# a user namespace where the caller is uid 0 and every other uid comes out of
# the subuid range. --user 1000 there means "subuid 1000", which is host uid
# 100999 — a stranger to the bind mount, so shfmt --write fails with
# `permission denied` on files the caller owns. --userns=keep-id maps the host
# uid to itself inside the namespace instead, which makes --user mean what it
# says and keeps written files owned by the caller. It is rootless-only, so it
# is added only when the engine reported rootless.
user_args() {
  [[ "$ENGINE_ROOTLESS" == "1" ]] && printf '%s\n' --userns=keep-id
  printf '%s\n%s:%s\n' --user "$(id -u)" "$(id -g)"
}

# in_container <writable?> <cmd...> — run a tool from the lint image.
# The mount is read-only unless the tool needs to write, and the network is
# off: linters read code and nothing more.
in_container() {
  local writable="$1"; shift
  local mount="$REPO_ROOT:/mnt:ro"
  [[ "$writable" == "rw" ]] && mount="$REPO_ROOT:/mnt"

  local -a as_user=()
  mapfile -t as_user < <(user_args)

  run "$CONTAINER_ENGINE" run --rm \
    --network none \
    "${as_user[@]}" \
    --volume "$mount" \
    --workdir /mnt \
    "$LINT_IMAGE" "$@"
}

run_shellcheck_container() {
  in_container ro shellcheck \
    --external-sources --severity=style --color=always "${FILES[@]}"
}

run_shfmt_container() {
  if [[ "$FIX" == "1" ]]; then
    in_container rw shfmt --indent 2 --case-indent --binary-next-line --write "${FILES[@]}"
  else
    in_container ro shfmt --indent 2 --case-indent --binary-next-line --diff "${FILES[@]}"
  fi
}

run_shellcheck_host() {
  ( cd "$REPO_ROOT" && run shellcheck --external-sources --severity=style "${FILES[@]}" )
}

run_shfmt_host() {
  local args=(--diff)
  [[ "$FIX" == "1" ]] && args=(--write)
  ( cd "$REPO_ROOT" && run shfmt --indent 2 --case-indent --binary-next-line "${args[@]}" "${FILES[@]}" )
}

# --- dispatch --------------------------------------------------------------

if [[ "$USE_CONTAINER" != "no" ]] && detect_engine; then
  MODE=container
  LINT_IMAGE="$(image_name)"
  ensure_image "$LINT_IMAGE"
  engine_label="$CONTAINER_ENGINE"
  [[ "$ENGINE_ROOTLESS" == "1" ]] && engine_label="rootless $CONTAINER_ENGINE"
  log "Linting ${#FILES[@]} file(s) with $LINT_IMAGE via $engine_label"
elif [[ "$USE_CONTAINER" == "yes" ]]; then
  printf '%s err%s No usable container engine (is the docker daemon running?).\n' "$C_RED" "$C_RESET" >&2
  exit 3
elif have shellcheck; then
  MODE=host
  warn "No container engine; falling back to host shellcheck $(shellcheck --version | awk '/^version:/{print $2}')"
else
  warn "No container engine and no host shellcheck; nothing to lint with."
  warn "Start the docker service, or install shellcheck and pass --no-container."
  exit 3
fi

failures=0

if [[ "$MODE" == "container" ]]; then
  run_shellcheck_container || failures=$((failures + 1))
else
  run_shellcheck_host || failures=$((failures + 1))
fi
[[ "$failures" -eq 0 ]] && ok "shellcheck clean"

if [[ "$RUN_FMT" == "1" ]]; then
  log "Checking formatting with shfmt"
  if [[ "$MODE" == "container" ]]; then
    run_shfmt_container || failures=$((failures + 1))
  else
    have shfmt || die "shfmt not installed; drop --no-container to use the container."
    run_shfmt_host || failures=$((failures + 1))
  fi
  if [[ "$failures" -eq 0 ]]; then
    ok "formatting clean"
  elif [[ "$FIX" == "1" ]]; then
    ok "reformatted"
  fi
fi

[[ "$failures" -gt 0 ]] && die "Lint failed."
ok "All checks passed."
