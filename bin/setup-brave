#!/usr/bin/env bash
#
# setup-brave — build vetted Brave package and make it the default browser.
#
# order: 60
# description: Build vetted Brave package and make it the default browser
#
# This uses the repository-owned package recipe in packages/brave. The recipe
# resolves the latest public stable RPM through Brave's official endpoint and
# verifies Brave's signed checksum. It does not use the AUR or an AUR helper.
#
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
# shellcheck source=../lib/common.sh
source "$REPO_ROOT/lib/common.sh"

PACKAGE_DIR="$REPO_ROOT/packages/brave"
PACKAGE_NAME="brave-browser-local"
PREPARE_LATEST="${BRAVE_PREPARE_LATEST:-$PACKAGE_DIR/prepare-latest}"
EXTENSION_FILTER="${BRAVE_EXTENSION_FILTER:-$REPO_ROOT/bin/setup-no-chromium-extensions}"
OMARCHY_ROOT="${OMARCHY_ROOT:-/usr/share/omarchy}"
POLICY_DIR="${BRAVE_POLICY_DIR:-/etc/brave/policies/managed}"
CURRENT_USER="$(id -un)"
CURRENT_GROUP="$(id -gn)"
FLAGS_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/brave-flags.conf"

usage() {
  cat <<'USAGE'
Usage: setup-brave [options]

Resolves Brave's latest public stable release, authenticates its signed
checksum, builds this repository's vetted package recipe, installs it with
pacman, applies Omarchy integration, and makes Brave the default. No AUR
package, recipe, repository, or helper is used.

Options:
  -n, --dry-run   Show what would change without changing anything.
  -y, --yes       Accepted for setup-all compatibility.
  -h, --help      Show this help.

Environment:
  DRY_RUN=1       Same as --dry-run.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1 ;;
    -y|--yes)     ASSUME_YES=1 ;;
    -h|--help)    usage; exit 0 ;;
    *)            usage >&2; die "Unknown argument: $1" ;;
  esac
  shift
done

require_not_root
require_cmd omarchy pacman makepkg sudo
[[ "$(uname -m)" == "x86_64" ]] \
  || die "The vetted Brave package currently supports x86_64 only"
[[ -f "$PACKAGE_DIR/PKGBUILD.template" && -f "$PACKAGE_DIR/brave-launcher" \
   && -x "$PREPARE_LATEST" ]] \
  || die "Brave package recipe is incomplete: $PACKAGE_DIR"
[[ -x "$EXTENSION_FILTER" ]] \
  || die "Chromium extension filter is missing: $EXTENSION_FILTER"
[[ -f "$OMARCHY_ROOT/config/chromium-flags.conf" ]] \
  || die "Omarchy Chromium flags were not found"

for conflicting_package in brave-bin brave-browser; do
  # pacman resolves -Q targets through provides= entries. Our package provides
  # both legacy names, so check the resolved package's real name before
  # treating it as a separately installed conflict.
  resolved_package="$(pacman -Q "$conflicting_package" 2>/dev/null \
    | awk 'NR == 1 { print $1 }' || true)"
  if [[ "$resolved_package" == "$conflicting_package" ]]; then
    die "Remove conflicting package $conflicting_package before installing the vetted build"
  fi
done

installed_version="$(pacman -Q "$PACKAGE_NAME" 2>/dev/null | awk '{print $2}' || true)"
current_browser="$(omarchy default browser)"
build_dir="$(mktemp -d "${TMPDIR:-/tmp}/omarchy-brave.XXXXXX")"
trap 'rm -rf "$build_dir"' EXIT
cp "$PACKAGE_DIR/PKGBUILD.template" "$PACKAGE_DIR/brave-launcher" "$build_dir/"
latest_version="$($PREPARE_LATEST "$build_dir")"
package_version="$latest_version-1"

if [[ "$installed_version" != "$package_version" ]]; then
  log "Building vetted Brave $package_version from its signed first-party stable RPM"
  if [[ "$DRY_RUN" == "1" ]]; then
    printf '%s  dry%s makepkg --syncdeps --install --cleanbuild --noconfirm --needed (%s)\n' \
      "$C_DIM" "$C_RESET" "$build_dir/PKGBUILD"
  else
    (
      cd "$build_dir"
      makepkg --syncdeps --install --cleanbuild --noconfirm --needed
    )
  fi
else
  skip "Latest stable Brave $package_version is already installed"
fi

# Reuse the repository's Chromium-extension policy so running this script by
# itself cannot restore integrations setup-no-chromium-extensions removes.
cp "$OMARCHY_ROOT/config/chromium-flags.conf" "$build_dir/brave-flags.conf"
CHROMIUM_FLAGS_DIR="$build_dir" "$EXTENSION_FILTER" --yes >/dev/null
write_file "$FLAGS_FILE" < "$build_dir/brave-flags.conf"

if [[ ! -d "$POLICY_DIR" || ! -w "$POLICY_DIR" ]]; then
  log "Creating Brave's managed-policy directory"
  run sudo install -d -m 0755 -o "$CURRENT_USER" -g "$CURRENT_GROUP" "$POLICY_DIR"
else
  skip "Brave policy directory is ready"
fi

if [[ ! -f "$POLICY_DIR/color.json" ]]; then
  log "Applying the current Omarchy browser theme to Brave"
  run omarchy theme set browser
else
  skip "Brave browser theme policy is already installed"
fi

if [[ "$current_browser" != "brave" ]]; then
  log "Making Brave the default browser"
  run omarchy default browser brave
else
  skip "Brave is already the default browser"
fi

if [[ "$DRY_RUN" == "1" ]]; then
  exit 0
fi

[[ "$(pacman -Q "$PACKAGE_NAME" | awk '{print $2}')" == "$package_version" ]] \
  || die "$PACKAGE_NAME $package_version was not registered as installed"
[[ "$(omarchy default browser)" == "brave" ]] \
  || die "Brave was not registered as the default browser"
[[ -f "$FLAGS_FILE" ]] || die "Brave's Omarchy flags are missing"
[[ -f "$POLICY_DIR/color.json" ]] \
  || die "Brave's Omarchy theme policy is missing"

ok "Vetted Brave installed with Omarchy integration and set as default"
