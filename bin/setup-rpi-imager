#!/usr/bin/env bash
#
# setup-rpi-imager — install Raspberry Pi Imager from Arch's official repos.
#
# order: 60
# description: Install Raspberry Pi Imager from Arch Extra
#
# Raspberry Pi publishes an AppImage for generic Linux distributions, but
# Arch packages rpi-imager in the signed Extra repository. Installing that
# package through Omarchy gives us native dependencies, desktop and polkit
# integration, and updates with the rest of the system without involving AUR.
#
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

PACKAGES=(rpi-imager xorg-xhost)

usage() {
  cat <<'USAGE'
Usage: setup-rpi-imager [options]

Installs Raspberry Pi Imager and its Xwayland authorization helper from Arch's
signed official Extra repository through Omarchy's package helper. It does not
use AUR or download an AppImage.

Options:
  -n, --dry-run   Show what would change without changing anything.
  -y, --yes       Accepted for setup-all compatibility.
  -h, --help      Show this help.

Environment:
  DRY_RUN=1       Same as --dry-run.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1 ;;
    -y|--yes)     ASSUME_YES=1 ;;
    -h|--help)    usage; exit 0 ;;
    *)            usage >&2; die "Unknown argument: $1" ;;
  esac
  shift
done

require_not_root
require_cmd omarchy

missing=()
for package in "${PACKAGES[@]}"; do
  if ! omarchy pkg present "$package"; then
    missing+=("$package")
  fi
done

if [[ ${#missing[@]} -eq 0 ]]; then
  skip "Raspberry Pi Imager and Xwayland authorization helper already installed"
  exit 0
fi

log "Installing Raspberry Pi Imager with Omarchy-compatible GUI authorization"
run omarchy pkg add "${missing[@]}"

if [[ "$DRY_RUN" == "1" ]]; then
  exit 0
fi

for package in "${PACKAGES[@]}"; do
  omarchy pkg present "$package" \
    || die "$package was not registered as installed"
done

ok "Raspberry Pi Imager installed with Xwayland authorization support"
