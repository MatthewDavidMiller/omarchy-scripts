#!/usr/bin/env bash
#
# setup-no-aur-updates — keep `omarchy update` away from the AUR.
#
# order: 35
# description: Stop omarchy update from reaching the AUR
#
# `omarchy update` runs omarchy-update-aur-pkgs between the post-update hook
# and the mise step. That script opens on `pacman -Qem`, which lists exactly
# one foreign package here: brave-browser-local, the package this repository
# builds itself from Brave's signed first-party release. Not an AUR package,
# but foreign, so the gate opens and omarchy-pkg-aur-accessible runs:
#
#   curl -sf --connect-timeout 30 --retry 3 --retry-delay 3 ... aur.archlinux.org
#
# What that probe costs depends on the OpenSnitch verdict of the moment. A drop
# costs 30 + 3 + 30 + 3 + 30 + 3 + 30 ~= 129s of retry budget before the update
# continues; a process-wide `allow curl` answered at some prompt lets it
# through and the AUR step runs for real. Either way it is a question the
# package-source policy already settled.
#
# The fix is a set of shims in /usr/local/bin, a directory pacman never writes
# to. Editing /usr/share/omarchy would not survive: omarchy-update-system-pkgs
# runs pacman -Syu with --overwrite '/usr/share/omarchy/*' on every update.
#
# A shim is only worth anything if the name resolves to it, and /usr/local/bin
# preceding /usr/bin is not enough to guarantee that — see the PATH precedence
# section below. This checks, and fails when it does not hold.
#
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/common.sh
source "$SCRIPT_DIR/../lib/common.sh"

# Overridable so the tests can point at fixtures instead of the real system.
SHIM_DIR="${OMARCHY_SHIM_DIR:-/usr/local/bin}"
BIN_DIR="${OMARCHY_BIN_DIR:-/usr/bin}"

# Every shim carries this line. Nothing without it is ever overwritten or
# removed, so a file someone else put in the shim directory is reported and
# left alone.
MARKER='omarchy-scripts:no-aur-updates'

# The upstream commands that reach the AUR, in the order they matter.
OMARCHY_SHIMS=(
  "omarchy-update-aur-pkgs"
  "omarchy-pkg-aur-accessible"
  "omarchy-pkg-aur-add"
  "omarchy-pkg-aur-install"
)

# Helper package names. Quoted deliberately: tests/test-repo.sh greps bin/setup-*
# for a bare helper invocation, and these are pacman removal targets, never
# commands this script runs.
AUR_HELPERS=("yay" "paru")

WORK_DIR=""

# Set when a shim could not be written. A run that installed nothing must not
# report success, whatever the reason sudo gave.
WRITE_FAILED=0

# --allow-aur-updates puts the machine back the way Omarchy ships it.
REVERT=0

usage() {
  cat <<'USAGE'
Usage: setup-no-aur-updates [options]

Stops `omarchy update` from contacting the AUR, which this machine takes no
packages from. Installs no-op shims into /usr/local/bin, removes the AUR helper
package, and checks that the shimmed names actually resolve to the shims.

Options:
  -n, --dry-run             Show what would change without changing anything.
  -y, --yes                 Do not prompt for confirmation.
      --allow-aur-updates   Reverse: remove the shims. Does not reinstall the
                            helper package.
  -h, --help                Show this help.

Environment (primarily for tests):
  DRY_RUN=1                 Same as --dry-run.
  OMARCHY_SHIM_DIR          Where shims are installed. Default: /usr/local/bin.
  OMARCHY_BIN_DIR           Where Omarchy's own commands live. Default: /usr/bin.
  OMARCHY_LOGIN_PATH        PATH to check precedence against, instead of asking
                            a login shell.
  OMARCHY_MANAGER_PATH      PATH to check precedence against, instead of asking
                            the systemd user manager; empty skips that check.
                            Setting it also stops this script from writing the
                            real session environment.
  OMARCHY_DEV_CONF          The dev-link marker. Default: /etc/omarchy.conf.
USAGE
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run)          DRY_RUN=1 ;;
    -y|--yes)              ASSUME_YES=1 ;;
    --allow-aur-updates)   REVERT=1 ;;
    -h|--help)             usage; exit 0 ;;
    *)                     usage >&2; die "Unknown argument: $1" ;;
  esac
  shift
done

require_not_root
require_cmd mktemp omarchy pacman sudo install cmp

cleanup() {
  [[ -n "$WORK_DIR" ]] && rm -rf -- "$WORK_DIR"
}
trap cleanup EXIT
WORK_DIR="$(mktemp -d "${TMPDIR:-/tmp}/omarchy-no-aur-updates.XXXXXX")"

# ---------------------------------------------------------------------------
# Shim contents
# ---------------------------------------------------------------------------
# Written to stdout so the caller can compare them against what is installed
# and skip an identical file. Each one is standalone: it must keep working
# after this repository is deleted.
render_shim() {
  local name="$1"
  printf '#!/usr/bin/env bash\n#\n# %s\n' "$MARKER"

  case "$name" in
    omarchy-update-aur-pkgs)
      cat <<'SHIM'
#
# Shadows the update step of the same name. Nothing on this machine comes from
# the AUR, so there is never anything for it to update. Upstream reaches the
# same answer only after a reachability probe over the network.
#
# Reverse with: setup-no-aur-updates --allow-aur-updates
printf '\n\033[32mAUR updates disabled by omarchy-scripts\033[0m\n\n'
exit 0
SHIM
      ;;
    omarchy-pkg-aur-accessible)
      cat <<'SHIM'
#
# Shadows the reachability probe of the same name, which curls aur.archlinux.org
# with --connect-timeout 30 --retry 3 --retry-delay 3. Blocked, that probe burns
# about 129 seconds of retry budget; allowed, it reports the AUR as up and the
# update goes on to run a helper this machine does not have. Neither is wanted,
# and unreachable is the honest answer for a machine that takes nothing from
# there.
exit 1
SHIM
      ;;
    omarchy-pkg-aur-add|omarchy-pkg-aur-install)
      cat <<'SHIM'
#
# Shadows the AUR installer of the same name. This machine takes packages from
# the official Arch and Omarchy repositories, or from a recipe vetted in
# omarchy-scripts, and nothing from the AUR.
printf '%s: refusing, this machine installs nothing from the AUR.\n' "${0##*/}" >&2
printf 'Use `omarchy pkg add NAME` for a repository package, or add a vetted\n' >&2
printf 'recipe under packages/ in omarchy-scripts.\n' >&2
exit 1
SHIM
      ;;
    *)
      cat <<'SHIM'
#
# Shadows the AUR helper of the same name, which omarchy-scripts removed.
#
# Read-only local queries are forwarded to pacman, because omarchy-pkg-remove —
# the `omarchy pkg remove` picker, which has nothing to do with the AUR — runs
# `-Qqe` and `-Qi` through this name and would otherwise stop working. Anything
# that could install or sync is refused.
case "${1:-}" in
  -Q*) exec pacman "$@" ;;
esac
printf '%s: refusing, this machine installs nothing from the AUR.\n' "${0##*/}" >&2
printf 'Use `omarchy pkg add NAME` for a repository package, or add a vetted\n' >&2
printf 'recipe under packages/ in omarchy-scripts.\n' >&2
exit 1
SHIM
      ;;
  esac
}

# ---------------------------------------------------------------------------
# State
# ---------------------------------------------------------------------------
ours() {
  local path="$1"
  [[ -f "$path" ]] && grep -qF -- "$MARKER" "$path"
}

helper_installed() {
  pacman -Qq "$1" >/dev/null 2>&1
}

# The helper names this run should shim: the ones still installed, plus the
# ones already carrying our shim. That second half is what keeps a second run
# idempotent once the package itself is gone.
helper_shims() {
  local helper
  for helper in "${AUR_HELPERS[@]}"; do
    if helper_installed "$helper" || ours "$SHIM_DIR/$helper"; then
      printf '%s\n' "$helper"
    fi
  done
}

shim_names() {
  printf '%s\n' "${OMARCHY_SHIMS[@]}"
  helper_shims
}

# ---------------------------------------------------------------------------
# Installing
# ---------------------------------------------------------------------------
# Compare, back up, and install a root-owned file. Tests point SHIM_DIR at a
# fixture and stub sudo, so no test reaches the real system.
install_root_file() {
  local source="$1" destination="$2" mode="${3:-0644}" backup
  if [[ -f "$destination" ]] && cmp -s "$source" "$destination"; then
    skip "$destination already up to date"
    return 1
  fi
  if [[ "$DRY_RUN" == "1" ]]; then
    printf '%s  dry%s would write %s\n' "$C_DIM" "$C_RESET" "$destination"
    return 0
  fi
  # Checked rather than left to set -e: the caller ends in `|| true` to let a
  # skip through, and that suppresses set -e for this whole body. Without these
  # tests a sudo that could not read a password printed "ok wrote" over a file
  # it never touched.
  if [[ -f "$destination" ]]; then
    backup="$destination.bak.$(date +%Y%m%d%H%M%S)"
    if ! sudo cp -a -- "$destination" "$backup"; then
      warn "could not back up $destination — leaving it as it is"
      WRITE_FAILED=1
      return 1
    fi
    ok "backed up $destination to $backup"
  fi
  if ! sudo install -D -m "$mode" -- "$source" "$destination"; then
    warn "could not write $destination"
    WRITE_FAILED=1
    return 1
  fi
  ok "wrote $destination"
}

install_shims() {
  local name destination source upstream

  log "Installing AUR shims into $SHIM_DIR"
  while IFS= read -r name; do
    destination="$SHIM_DIR/$name"

    if [[ -e "$destination" ]] && ! ours "$destination"; then
      warn "$destination exists and is not ours — leaving it alone"
      continue
    fi

    # Only the Omarchy commands are expected upstream; a helper's own binary is
    # gone once this script has removed the package.
    case "$name" in
      omarchy-*)
        upstream="$BIN_DIR/$name"
        [[ -e "$upstream" ]] \
          || warn "$upstream is gone — this shim may be stale against a newer Omarchy"
        ;;
    esac

    source="$WORK_DIR/$name"
    render_shim "$name" > "$source"
    install_root_file "$source" "$destination" 0755 || true
  done < <(shim_names)
}

remove_shims() {
  local name destination removed=0

  log "Removing AUR shims from $SHIM_DIR"
  while IFS= read -r name; do
    destination="$SHIM_DIR/$name"

    if [[ ! -e "$destination" ]]; then
      skip "$destination is already gone"
      continue
    fi
    if ! ours "$destination"; then
      warn "$destination is not ours — leaving it alone"
      continue
    fi

    run sudo rm -f -- "$destination"
    [[ "$DRY_RUN" == "1" ]] || ok "removed $destination"
    removed=$((removed + 1))
  done < <(printf '%s\n' "${OMARCHY_SHIMS[@]}" "${AUR_HELPERS[@]}")

  [[ "$removed" -gt 0 ]] || skip "no shims to remove"
}

# ---------------------------------------------------------------------------
# The helper package
# ---------------------------------------------------------------------------
remove_helper_packages() {
  local helper
  local -a installed=() targets=()

  log "Removing the AUR helper package"
  for helper in "${AUR_HELPERS[@]}"; do
    if helper_installed "$helper"; then
      installed+=("$helper")
    else
      skip "$helper is not installed"
    fi
  done

  if [[ ${#installed[@]} -eq 0 ]]; then
    return 0
  fi

  # `pacman -Rs --print` asks pacman for the full removal set without root and
  # without changing anything, so the confirmation is informed. Note -n and
  # --print are mutually exclusive, which is why the preview drops the -n the
  # removal itself uses.
  mapfile -t targets < <(pacman -Rs --print "${installed[@]}" 2>/dev/null \
    || printf '%s\n' "${installed[@]}")

  local target
  for target in "${targets[@]}"; do
    printf '  %s-%s %s\n' "$C_DIM" "$C_RESET" "$target"
  done

  if ! confirm "Remove ${#targets[@]} package(s)?"; then
    skip "left ${installed[*]} installed"
    return 0
  fi

  # `omarchy pkg drop` is pacman -Rns --noconfirm over whatever subset is
  # actually installed, which is exactly what this needs.
  run omarchy pkg drop "${installed[@]}"

  [[ "$DRY_RUN" == "1" ]] && return 0
  local pkg
  for pkg in "${installed[@]}"; do
    if helper_installed "$pkg"; then
      die "$pkg is still installed"
    fi
  done
  ok "removed ${installed[*]}"
}

# ---------------------------------------------------------------------------
# PATH precedence
# ---------------------------------------------------------------------------
# A shim only helps if the name resolves to it. The first version of this
# compared SHIM_DIR against BIN_DIR and reported success on a machine where
# every omarchy-* shim was inert: /usr/share/omarchy/bin is a farm of symlinks
# pointing back into /usr/bin, so a PATH carrying it ahead of SHIM_DIR reaches
# the upstream command without BIN_DIR ever appearing earlier. The helper shim
# was the one that did run, because that directory has no counterpart to it.
#
# So walk the PATH per shim name, the way the shell does, and report whatever
# gets there first. That catches any shadowing directory, not one named here.

# Where the dev-link marker lives. Overridable so the tests can point at a
# fixture instead of the real /etc.
OMARCHY_DEV_CONF="${OMARCHY_DEV_CONF:-/etc/omarchy.conf}"

# Set when a shim loses on a PATH that matters, which makes the run fail. The
# two are tracked apart because they have different fixes: the manager PATH is
# what a fresh session starts from and can be repaired here, while a login
# shell's is this session's own and only a new session replaces it.
PRECEDENCE_FAILED=0
MANAGER_CHECKED=0
MANAGER_FAILED=0

# The trailing newline matters: without it `read` never returns the last entry,
# so the final PATH directory is invisible to every check below.
split_path() { printf '%s\n' "$1" | tr ':' '\n'; }

path_has() {
  local dir="$1" entry
  while IFS= read -r entry; do
    [[ "$entry" == "$dir" ]] && return 0
  done < <(split_path "$2")
  return 1
}

# path_without <dir> <path> — <path> with every occurrence of <dir> dropped.
path_without() {
  local dir="$1" entry out=""
  while IFS= read -r entry; do
    [[ "$entry" == "$dir" ]] && continue
    out+="${out:+:}$entry"
  done < <(split_path "$2")
  printf '%s' "$out"
}

# shim_shadow <name> <path> — prints what <path> reaches before our shim and
# returns 0 when the shim loses; returns 1 when it wins. Compares directories
# rather than files so a --dry-run, which has installed nothing yet, still
# reports what the PATH will do.
shim_shadow() {
  local name="$1" entry
  while IFS= read -r entry; do
    [[ -n "$entry" ]] || continue
    [[ "$entry" == "$SHIM_DIR" ]] && return 1
    if [[ -f "$entry/$name" && -x "$entry/$name" ]]; then
      printf '%s' "$entry/$name"
      return 0
    fi
  done < <(split_path "$2")
  return 1
}

# check_path <label> <path> — report how <path> resolves every shim name.
check_path() {
  local label="$1" path="$2" name winner failed=0

  if ! path_has "$SHIM_DIR" "$path"; then
    warn "$SHIM_DIR is not on the $label PATH — the shims will not be found"
    PRECEDENCE_FAILED=1
    return 1
  fi

  while IFS= read -r name; do
    if winner="$(shim_shadow "$name" "$path")"; then
      warn "$label PATH reaches $winner before $SHIM_DIR/$name"
      failed=1
    fi
  done < <(shim_names)

  if [[ "$failed" == "1" ]]; then
    PRECEDENCE_FAILED=1
    return 1
  fi
  ok "$SHIM_DIR wins every shim name on the $label PATH"
}

login_path() {
  if [[ -n "${OMARCHY_LOGIN_PATH:-}" ]]; then
    printf '%s' "$OMARCHY_LOGIN_PATH"
    return 0
  fi
  bash -lc 'printf "%s" "$PATH"' 2>/dev/null || printf '%s' "$PATH"
}

# The PATH the systemd user manager hands to what it starts. Worth its own
# check: under a uwsm/Hyprland login that manager holds the session PATH and
# outlives a logout, so a stale entry baked in there is not cleared by opening
# a new shell. Empty when there is no user manager, which is the test's case.
manager_path() {
  if [[ -n "${OMARCHY_MANAGER_PATH+x}" ]]; then
    printf '%s' "$OMARCHY_MANAGER_PATH"
    return 0
  fi
  have systemctl || return 0
  systemctl --user show-environment 2>/dev/null | sed -n 's/^PATH=//p' | head -n 1
}

# The packaged Omarchy bin directory, when having it on PATH is stale state
# rather than something in use. env-bootstrap prepends it only under
# `omarchy dev link`; on a production install it says the directory "would just
# be noise" and leaves it off. But env-bootstrap only ever adds, so a copy
# inherited from a dev link that has since been undone — or from an older
# bootstrap that prepended unconditionally — is never taken back out.
stale_omarchy_bin() {
  local base="${OMARCHY_PATH:-/usr/share/omarchy}"
  [[ -f "$OMARCHY_DEV_CONF" ]] && return 1
  printf '%s/bin' "${base%/}"
}

# Drop the stale entry from the systemd user manager, so processes it starts
# from here on resolve the shims. Shells that are already running keep the PATH
# they were given; only a fresh session clears those.
repair_manager_path() {
  local stale="$1" path cleaned

  # Only ever repair a PATH actually read from systemd. When OMARCHY_MANAGER_PATH
  # supplies one, this is a test or a what-if and the real session environment is
  # not ours to write. Without this a suite that forgets to stub systemctl edits
  # the PATH of the session running it, which is how this guard got written.
  if [[ -n "${OMARCHY_MANAGER_PATH+x}" ]]; then
    skip "OMARCHY_MANAGER_PATH is set — not touching the real session environment"
    return 1
  fi

  path="$(manager_path)"
  [[ -n "$path" ]] || return 1
  path_has "$stale" "$path" || return 1

  cleaned="$(path_without "$stale" "$path")"
  log "Repairing the session PATH"
  printf '  %s-%s dropping %s, which env-bootstrap only adds under a dev link\n' \
    "$C_DIM" "$C_RESET" "$stale"

  if ! confirm "Drop it from the systemd user environment?"; then
    skip "left $stale on the session PATH"
    return 1
  fi

  run systemctl --user set-environment "PATH=$cleaned"
  [[ "$DRY_RUN" == "1" ]] || ok "dropped $stale from the systemd user environment"
}

report_path_precedence() {
  local stale manager

  log "Checking PATH precedence"
  check_path login "$(login_path)" || true

  manager="$(manager_path)"
  if [[ -n "$manager" ]]; then
    MANAGER_CHECKED=1
    check_path "systemd user manager" "$manager" || MANAGER_FAILED=1
  fi

  [[ "$PRECEDENCE_FAILED" == "1" ]] || return 0

  # One shadowing directory has a known, reversible cause. Anything else is
  # this machine's own PATH and only the person who arranged it can say why.
  if stale="$(stale_omarchy_bin)"; then
    repair_manager_path "$stale" || true
  fi
}

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
shim_state() {
  local path="$1"
  if [[ ! -e "$path" ]]; then
    printf 'no shim'
  elif ours "$path"; then
    printf 'shim installed'
  else
    printf 'not ours — left alone'
  fi
}

summary() {
  local name helper

  log "Done"
  if [[ "$REVERT" == "1" ]]; then
    cat <<EOF

The shims are gone, so \`omarchy update\` reaches the AUR on Omarchy's own
terms again — including the reachability probe that takes about 129 seconds to
fail while the AUR is blocked.

The helper package is not reinstalled. If you want it back:
  omarchy pkg add ${AUR_HELPERS[0]}
EOF
  elif [[ "$WRITE_FAILED" == "1" ]]; then
    cat <<EOF

At least one shim could not be written, so \`omarchy update\` still reaches the
AUR through whichever name is missing. The warnings above say which.

EOF
  elif [[ "$PRECEDENCE_FAILED" == "1" ]] &&
       [[ "$MANAGER_CHECKED" == "1" ]] && [[ "$MANAGER_FAILED" == "0" ]]; then
    cat <<EOF

The shims are installed and a new session will resolve them, but this one still
reaches what the warnings above name, so \`omarchy update\` run from a terminal
started before now still probes aur.archlinux.org.

Log out and back in, then check with:
  command -v omarchy-update-aur-pkgs
EOF
  elif [[ "$PRECEDENCE_FAILED" == "1" ]]; then
    cat <<EOF

The shims are installed but something on PATH gets to those names first, so
\`omarchy update\` still runs Omarchy's own AUR step and still probes
aur.archlinux.org. The warnings above name what wins and where.

Until PATH is fixed the shims change nothing. Re-run this once it is:
  ./bin/setup-no-aur-updates
EOF
  else
    cat <<EOF

\`omarchy update\` now skips the AUR step without a network request, saving
about two minutes per update. Nothing under /usr/share/omarchy was touched, so
an Omarchy upgrade cannot undo this.

Reverse it with:
  ./bin/setup-no-aur-updates --allow-aur-updates
EOF
  fi

  printf '\n'
  log "Current state"
  printf '  shim directory: %s\n' "$SHIM_DIR"
  for name in "${OMARCHY_SHIMS[@]}"; do
    printf '  %-27s %s\n' "$name" "$(shim_state "$SHIM_DIR/$name")"
  done
  for helper in "${AUR_HELPERS[@]}"; do
    if helper_installed "$helper"; then
      printf '  %-27s %s\n' "$helper" "$(shim_state "$SHIM_DIR/$helper"), package still installed"
    else
      printf '  %-27s %s\n' "$helper" "$(shim_state "$SHIM_DIR/$helper"), package not installed"
    fi
  done
}

main() {
  if [[ "$REVERT" == "1" ]]; then
    remove_shims
  else
    install_shims
    remove_helper_packages
    report_path_precedence
  fi
  summary

  # A shim that was never written, or one that is shadowed, leaves the next
  # update reaching the AUR anyway. Neither is a warning. setup-all collects it.
  [[ "$WRITE_FAILED" == "0" ]] || exit 1
  [[ "$PRECEDENCE_FAILED" == "0" ]] || exit 1
}

main "$@"
